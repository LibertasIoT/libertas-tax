# ---------------------------------------------------------------- Rust lexing

def code_mask(src):
    """1 for each character that is code, 0 inside comments and string/char literals."""
    n = len(src)
    mask = bytearray(n)
    i = 0
    while i < n:
        c = src[i]
        if c == '/' and i + 1 < n and src[i + 1] == '/':
            j = src.find('\n', i)
            i = n if j < 0 else j
            continue
        if c == '/' and i + 1 < n and src[i + 1] == '*':
            depth, i = 1, i + 2
            while depth:
                if src.startswith('/*', i):
                    depth, i = depth + 1, i + 2
                elif src.startswith('*/', i):
                    depth, i = depth - 1, i + 2
                else:
                    i += 1
            continue
        prev_ident = i > 0 and (src[i - 1].isalnum() or src[i - 1] == '_')
        if c in 'rb' and not prev_ident:
            m = re.compile(r'b?r(#*)"').match(src, i)
            if m:
                end = src.index('"' + m.group(1), m.end()) + 1 + len(m.group(1))
                mask[i] = 1  # the literal is one code token
                i = end
                continue
            if c == 'b' and i + 1 < n and src[i + 1] in '"\'':
                mask[i] = 1
                i += 1
                c = src[i]
                prev_ident = True
        if c == '"':
            mask[i] = 1
            i += 1
            while src[i] != '"':
                i += 2 if src[i] == '\\' else 1
            i += 1
            continue
        if c == "'":
            mask[i] = 1
            if src[i + 1] == '\\':
                i = src.index("'", i + 3) + 1
                continue
            if i + 2 < n and src[i + 2] == "'":
                i += 3
                continue
            i += 1  # a lifetime or label: the rest is an identifier
            continue
        mask[i] = 1
        i += 1
    return mask


class Text:
    def __init__(self, src):
        self.src = src
        self.mask = code_mask(src)

    def skip_trivia(self, i, end):
        while i < end and (not self.mask[i] or self.src[i].isspace()):
            i += 1
        return i

    def match_close(self, i):
        """Index after the bracket matching the one at i."""
        depth = 0
        while True:
            if self.mask[i]:
                c = self.src[i]
                if c in '([{':
                    depth += 1
                elif c in ')]}':
                    depth -= 1
                    if depth == 0:
                        return i + 1
            i += 1

    def skip_attrs(self, i, end):
        """Position of an item's first token after its attributes and comments."""
        i = self.skip_trivia(i, end)
        while self.src.startswith('#[', i) or self.src.startswith('#![', i):
            i = self.skip_trivia(self.match_close(self.src.index('[', i)), end)
        return i

    def items(self, start, end):
        """Top-level items in [start, end): dicts with lead (start of leading trivia),
        start (first attribute or token) and end (after the item and its line)."""
        src, mask = self.src, self.mask
        out, lead, i = [], start, start
        while True:
            i = self.skip_trivia(i, end)
            if i >= end:
                return out, lead
            first = i
            body = self.skip_attrs(i, end)
            semi_only = re.compile(r'(?:pub(?:\s*\([^)]*\))?\s+)?(?:const|static|use|type|let)\s').match(src, body) \
                and not re.compile(r'(?:pub(?:\s*\([^)]*\))?\s+)?const\s+(?:fn|unsafe|async|extern)\b').match(src, body)
            depth, j = 0, body
            while True:
                if mask[j]:
                    c = src[j]
                    if c in '([{':
                        depth += 1
                    elif c in ')]}':
                        depth -= 1
                        if depth == 0 and c == '}' and not semi_only:
                            j += 1
                            break
                    elif c == ';' and depth == 0:
                        j += 1
                        break
                j += 1
            m = re.compile(r'[ \t]*(//[^\n]*)?\n').match(src, j)
            if m:
                j = m.end()
            out.append({'lead': lead, 'start': first, 'body': body, 'end': j})
            lead = i = j


VIS = re.compile(r'pub(\s*\((crate|super|self|in\s[^)]*)\))?\s*')
NAMED = re.compile(r'(?:pub(?:\s*\([^)]*\))?\s+)?((?:const|async|unsafe|extern\s+"[^"]*")\s+)*'
                   r'(fn|struct|enum|union|trait|type|const|static|mod|use|extern\s+crate)\b\s*([A-Za-z_][A-Za-z0-9_]*)?')


def describe(t, it):
    """(kind, name) of an item; for impls the self type."""
    s, b = t.src, it['body']
    m = NAMED.match(s, b)
    if m and not s.startswith('impl', b):
        kind = m.group(2)
        return ('const' if kind == 'const' else kind.split()[0]), m.group(3)
    if re.compile(r'(?:unsafe\s+)?impl\b').match(s, b):
        return 'impl', impl_self(t, b)
    if re.compile(r'macro_rules\s*!').match(s, b):
        return 'macro_rules', None
    return 'macro', None


def impl_self(t, b):
    s = t.src
    brace = b
    while not (t.mask[brace] and s[brace] == '{'):
        brace += 1
    hdr = s[b:brace]
    hdr = re.sub(r'\bwhere\b.*', '', hdr, flags=re.S)
    hdr = re.sub(r'^(unsafe\s+)?impl\s*', '', hdr)
    if hdr.startswith('<'):
        hdr = hdr[angle_end(hdr, 0):]
    depth = 0
    for k, c in enumerate(hdr):
        if c == '<':
            depth += 1
        elif c == '>' and hdr[k - 1] != '-':
            depth -= 1
        elif depth == 0 and re.match(r'\sfor\s', hdr[k:k + 5]):
            hdr = hdr[k + 5:]
            break
    m = re.match(r"\s*&?\s*(?:'\w+\s+)?(?:mut\s+)?(?:\w+::)*(\w+)", hdr)
    return m.group(1) if m else None


def angle_end(s, i):
    depth = 0
    for k in range(i, len(s)):
        if s[k] == '<':
            depth += 1
        elif s[k] == '>' and s[k - 1] != '-':
            depth -= 1
            if depth == 0:
                return k + 1
    raise ValueError('unbalanced generics')


def is_trait_impl(t, it):
    s = t.src
    brace = it['body']
    while not (t.mask[brace] and s[brace] == '{'):
        brace += 1
    hdr = re.sub(r'\bwhere\b.*', '', s[it['body']:brace], flags=re.S)
    return re.search(r'\sfor\s', hdr) is not None


# ------------------------------------------------------- visibility rewrite

def deeper_vis(src, i, parent):
    """Edit (start, end, replacement) that keeps an item's visibility one module deeper,
    or None when it is unchanged. i is the item's first token after attributes."""
    m = VIS.match(src, i)
    if not m or not re.match(r'pub\b', src[i:i + 4]):
        return (i, i, 'pub(super) ')
    inner = (m.group(2) or '').strip()
    if inner == 'super':
        return (i, m.end(), parent + ' ')
    if inner == 'self':
        return (i, m.end(), 'pub(super) ')
    if inner.startswith('in') and re.match(r'in\s+(self|super)\b', inner):
        raise ValueError('relative pub(in ...) path')
    return None


def item_edits(t, it, kind, parent):
    """Visibility edits for a moved item: the item, struct fields, inherent impl members."""
    s = t.src
    edits = []
    if kind in ('fn', 'struct', 'enum', 'union', 'trait', 'type', 'const', 'static'):
        e = deeper_vis(s, it['body'], parent)
        if e:
            edits.append(e)
    if kind in ('struct', 'union'):
        edits += field_edits(t, it, parent)
    if kind == 'impl' and not is_trait_impl(t, it):
        open_ = it['body']
        while not (t.mask[open_] and s[open_] == '{'):
            open_ += 1
        members, _ = t.items(open_ + 1, t.match_close(open_) - 1)
        for mb in members:
            k, _ = describe(t, mb)
            if k in ('fn', 'type', 'const'):
                e = deeper_vis(s, mb['body'], parent)
                if e:
                    edits.append(e)
    return edits


def field_edits(t, it, parent):
    s, mask = t.src, t.mask
    j = NAMED.match(s, it['body']).end()
    while j < it['end'] and not (mask[j] and s[j] in '{(;'):
        if mask[j] and s[j] == '<':
            j = angle_end(s, j)
            continue
        j += 1
    if s[j] == ';':
        return []
    close = t.match_close(j) - 1
    edits = []
    starts = [j + 1]
    depth, k = 0, j + 1
    while k < close:
        if mask[k]:
            c = s[k]
            if c in '([{<':
                if c == '<' or True:
                    depth += 1
            elif c in ')]}' or (c == '>' and s[k - 1] != '-'):
                depth -= 1
            elif c == ',' and depth == 0:
                starts.append(k + 1)
        k += 1
    for st in starts:
        f = t.skip_attrs(st, close)
        if f >= close:
            continue
        if s[j] == '{' and not re.compile(r'(?:pub(?:\s*\([^)]*\))?\s+)?[A-Za-z_]\w*\s*:(?!:)').match(s, f):
            raise ValueError('unrecognized field at %d' % f)
        e = deeper_vis(s, f, parent)
        if e:
            edits.append(e)
    return edits


def apply_edits(src, base, edits):
    out, pos = [], base
    for a, b, r in sorted(edits):
        out.append(src[pos:a])
        out.append(r)
        pos = b
    return out, pos


def moved_text(t, start, end, edits):
    out, pos = apply_edits(t.src, start, [e for e in edits if start <= e[0] < end])
    out.append(t.src[pos:end])
    return ''.join(out)


# ------------------------------------------------------------- the split

def form_matcher(forms):
    exact, globs = {}, []
    for order, (form, area, names) in enumerate(forms):
        for name in names.split():
            if '*' in name:
                globs.append((-len(name.split('*')[0]), order, name, form))
            else:
                exact.setdefault(name, form)
    globs.sort()
    def match(name):
        if name is None:
            return None
        if name in exact:
            return exact[name]
        for _, _, pattern, form in globs:
            if fnmatch.fnmatchcase(name, pattern):
                return form
        return None
    return match


RELATIVE_PATH = re.compile(r'(?<![\w:])(self|super)::')


def uses_relative_path(t, a, b):
    for m in RELATIVE_PATH.finditer(t.src, a, b):
        if t.mask[m.start()]:
            return True
    return False


def registered_modules(t, items, hub_dir):
    """Modules declared inside the hub's actual top-level generated block."""
    bounds = []
    for marker in (MARKER, END_MARKER):
        line = re.search(r'(?m)^' + re.escape(marker) + r'(?=\n|$)', t.src)
        if (not line or (line.start() and not t.mask[line.start() - 1])
                or any(it['start'] <= line.start() < it['end'] for it in items)):
            return set()
        bounds.append(line)
    start, end = bounds
    if start.end() >= end.start():
        return set()
    registered = set()
    for it in items:
        if not start.end() <= it['start'] < it['end'] <= end.start():
            continue
        kind, name = describe(t, it)
        path = re.fullmatch(r'#\[\s*path\s*=\s*"([^"]+)"\s*\]\s*',
                            t.src[it['start']:it['body']])
        if kind == 'mod' and path and re.fullmatch(r'mod\s+\w+\s*;\s*',
                                                  t.src[it['body']:it['end']]):
            registered.add((name, os.path.normpath(os.path.join(hub_dir, path.group(1)))))
    return registered


def split_hub(root, hub, suffix, parent, forms):
    path = os.path.join(root, hub)
    with open(path, encoding='utf-8') as f:
        t = Text(f.read())
    src = t.src
    match = form_matcher(forms)
    hub_dir = os.path.dirname(path)
    items, tail = t.items(0, len(src))
    registered = registered_modules(t, items, hub_dir)
    moved = {}  # form -> list of chunks
    keep = []   # output pieces of the hub
    pos = 0
    for it in items:
        kind, name = describe(t, it)
        if kind in ('use', 'mod', 'extern', 'macro', 'macro_rules') or src.startswith('#!', it['start']):
            continue
        form = match(name)
        relative = uses_relative_path(t, it['start'], it['end'])
        if form and not relative:
            edits = item_edits(t, it, kind, parent)
            moved.setdefault(form, []).append(moved_text(t, it['lead'], it['end'], edits))
            keep.append(src[pos:it['lead']])
            pos = it['end']
            continue
        if kind != 'impl' or is_trait_impl(t, it):
            continue
        # A hub type's inherent impl: move the members whose names belong to a form.
        open_ = it['body']
        while not (t.mask[open_] and src[open_] == '{'):
            open_ += 1
        close = t.match_close(open_) - 1
        members, _ = t.items(open_ + 1, close)
        plan = []
        for mb in members:
            k, n = describe(t, mb)
            f = match(n) if k in ('fn', 'const', 'type') else None
            if f and uses_relative_path(t, mb['start'], mb['end']):
                f = None
            plan.append((mb, k, f))
        if not any(f for _, _, f in plan):
            continue
        header = src[it['start']:open_ + 1]
        by_form = {}
        for mb, k, f in plan:
            if f:
                e = deeper_vis(src, mb['body'], parent) if k in ('fn', 'const', 'type') else None
                by_form.setdefault(f, []).append(moved_text(t, mb['lead'], mb['end'], [e] if e else []))
        whole = all(f for _, _, f in plan)
        for n, (f, chunks) in enumerate(by_form.items()):
            chunks[0] = re.sub(r'\A(?:[ \t]*\n)+', '', chunks[0])
            lead = src[it['lead']:it['start']] if whole and n == 0 else '\n'
            moved.setdefault(f, []).append(lead + header + '\n' + ''.join(chunks) + '}\n')
        keep.append(src[pos:it['lead']])
        if whole:
            pos = it['end']
            continue
        keep.append(src[it['lead']:open_ + 1])
        p = open_ + 1
        for mb, k, f in plan:
            if f:
                keep.append(src[p:mb['lead']])
                p = mb['end']
        keep.append(src[p:it['end']])
        pos = it['end']
    keep.append(src[pos:])
    new_hub = ''.join(keep)

    # Every form in the table has its module, even an empty one, so the hub's module
    # block depends only on the table and two branches adding a form's first items
    # never both edit the hub. `pub use` re-exports each item at its own visibility.
    changed = []
    block_mods, block_uses, sources = [], [], [os.path.basename(path)]
    for module, form, area in sorted(('%s_%s' % (f, suffix), f, a) for f, a, _ in forms):
        base = ('src', 'federal', 'rules') if suffix == 'rules' else ('src',)
        child = os.path.join(root, *base, area, module + '.rs')
        if os.path.exists(child):
            with open(child, encoding='utf-8') as f:
                text = f.read()
            if ((module, os.path.normpath(child)) not in registered
                    and 'split out by tools/split-hubs' not in text.split('\n', 1)[0]):
                raise SystemExit('%s exists and is not a split-hubs module' % child)
        else:
            text = ('// %s items of %s, split out by tools/split-hubs.\n'
                    '#[allow(unused_imports)]\nuse super::*;\n' % (form, hub))
            changed.append((child, text))
        if form in moved:
            changed = [c for c in changed if c[0] != child] + [(child, text + ''.join(moved[form]))]
        block_mods.append('#[path = "%s"]\nmod %s;\n' % (os.path.relpath(child, hub_dir), module))
        # An empty module, or one whose items the hub's other code never names, leaves
        # its glob unused; the glob never changes resolution.
        block_uses.append('#[allow(unused_imports)]\npub use %s::*;\n' % module)
        sources.append(os.path.relpath(child, hub_dir))
    # Source-reading tests read the hub's whole text through HUB_SOURCE (unused
    # while no test reads that hub).
    source = ('#[cfg(test)]\n#[allow(dead_code)]\npub(crate) const HUB_SOURCE: &str = concat!(\n'
              + ''.join('    include_str!("%s"),\n' % s for s in sources) + ');\n')
    block_uses.sort(key=lambda u: [(int(c), '') if c.isdigit() else (-1, c)
                                   for c in re.split(r'(\d+)', u.split('pub use ')[1])])
    new_hub = replace_block(new_hub, MARKER + '\n' + ''.join(block_mods) + ''.join(block_uses)
                            + source + END_MARKER + '\n')
    if new_hub != src:
        changed.append((path, new_hub))
    return changed


def replace_block(src, block):
    lines = src.split('\n')
    if MARKER in lines:
        i, j = lines.index(MARKER), lines.index(END_MARKER) + 1
        return '\n'.join(lines[:i] + block.rstrip('\n').split('\n') + lines[j:])
    return src.rstrip('\n') + '\n\n' + block


INCLUDE_STR = re.compile(r'include_str!\("([^"]+)"\)')


def redirect_source_reads(root, hubs):
    """Point every `include_str!` of a hub file elsewhere in src at the hub's HUB_SOURCE."""
    targets = {os.path.normpath(os.path.join(root, h)): m + '::HUB_SOURCE' for h, m in hubs}
    changed = []
    for d, _, files in os.walk(os.path.join(root, 'src')):
        for f in sorted(files):
            p = os.path.join(d, f)
            if not f.endswith('.rs') or p in targets:
                continue
            src = open(p, encoding='utf-8').read()
            new = INCLUDE_STR.sub(lambda m: targets.get(
                os.path.normpath(os.path.join(d, m.group(1))), m.group(0)), src)
            if new != src:
                changed.append((p, new))
    return changed


def git(*args, **kw):
    return subprocess.run(['git'] + list(args), check=True, text=True, stdout=subprocess.PIPE, **kw).stdout.strip()


def ancestor(rev, root):
    return subprocess.run(['git', 'merge-base', '--is-ancestor', rev, 'HEAD'], cwd=root).returncode == 0


def adopt(argv):
    """Bring the current branch onto every split of MAIN (default origin/main) it lacks,
    oldest first. A split is a commit changing this tool; it holds the tool's output on
    its parent. For each: merge its parent (main just before it; stop on a conflict for
    the person to resolve, commit and rerun), then record the split as merged with this
    branch's own tree split by that split's tool, so later merges use it as their base."""
    root = git('rev-parse', '--show-toplevel')
    main_ref = argv[0] if argv else 'origin/main'
    if git('status', '--porcelain', cwd=root):
        raise SystemExit('commit or stash your changes first')
    splits = git('log', '--reverse', '--format=%H', main_ref, '--', 'tools/split-hubs', cwd=root).split()
    for split in splits:
        if ancestor(split, root):
            continue
        if not ancestor(split + '^', root):
            if subprocess.run(['git', 'merge', '--no-edit', split + '^'], cwd=root).returncode:
                raise SystemExit('resolve the conflicts with main before split %s, commit, and run '
                                 '--adopt again' % split[:12])
        tool = git('show', '%s:tools/split-hubs' % split, cwd=root)
        path = os.path.join(git('rev-parse', '--git-dir', cwd=root), 'split-hubs-%s.py' % split[:12])
        with open(path if os.path.isabs(path) else os.path.join(root, path), 'w', encoding='utf-8') as f:
            f.write(tool + '\n')
        git('merge', '-s', 'ours', '--no-commit', '--no-ff', split, cwd=root)
        git('checkout', split, '--', 'tools/split-hubs', cwd=root)
        subprocess.run([sys.executable, '-I', os.path.join(root, path), root], cwd=root, check=True,
                       stdout=subprocess.DEVNULL)
        git('add', '-A', 'src', 'tools/split-hubs', cwd=root)
        git('commit', '--no-edit', '-m', 'Adopt the hub split %s: its tools/split-hubs run on this branch'
            % split[:12], cwd=root)
        print('adopted', split[:12])
    print('now: git merge %s' % main_ref)
    return 0


def main(argv):
    if argv[:1] == ['--adopt']:
        return adopt(argv[1:])
    check = '--check' in argv
    args = [a for a in argv if a != '--check']
    root = os.path.abspath(args[0]) if args else git('rev-parse', '--show-toplevel')
    return split_tree(root, check)


def split_tree(root, check=False):
    changed = []
    for hub, _, suffix, parent, forms in HUBS:
        changed += split_hub(root, hub, suffix, parent, forms)
    changed += redirect_source_reads(root, [(h, m) for h, m, _, _, _ in HUBS])
    if check:
        for p, _ in changed:
            print('would change', os.path.relpath(p, root))
        return 1 if changed else 0
    for p, text in changed:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, 'w', encoding='utf-8') as f:
            f.write(text)
    if changed:
        subprocess.run(['rustfmt', '--edition', '2024'] + sorted({p for p, _ in changed}), cwd=root, check=True)
    for p, _ in changed:
        print('wrote', os.path.relpath(p, root))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
